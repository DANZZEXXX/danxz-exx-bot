#include <BleCombo.h>

// Pin Joystick & Tombol Mode
#define JOY_X 34
#define JOY_Y 35
#define JOY_SW 25
#define MODE_BTN 27 // Pin Pushbutton Mode (ke GND)

bool isMouseMode = false;

// Status tombol (mencegah spam BLE)
bool isW = false, isS = false, isA = false, isD = false;
bool lastJoyBtn = HIGH;
bool lastModeBtn = HIGH;

void setup() {
  Serial.begin(115200);
  pinMode(JOY_SW, INPUT_PULLUP);
  pinMode(MODE_BTN, INPUT_PULLUP);

  // Inisialisasi Bluetooth Combo (Keyboard + Mouse)
  Keyboard.begin();
  Mouse.begin();
}

void loop() {
  if (Keyboard.isConnected()) {

    // ==========================================
    // TOGGLE MODE (Bila Pushbutton Mode Ditekan)
    // ==========================================
    bool modeBtnState = digitalRead(MODE_BTN);
    if (lastModeBtn == HIGH && modeBtnState == LOW) {
      isMouseMode = !isMouseMode; // Berpindah mode

      // Lepas semua tombol jika pindah ke mode kursor
      if (isMouseMode) {
        Keyboard.releaseAll();
        isW = isS = isA = isD = false;
        Serial.println("Mode Aktif: KURSOR MOUSE");
      } else {
        Serial.println("Mode Aktif: NORMAL (WASD)");
      }
      delay(200); // Debounce tombol
    }
    lastModeBtn = modeBtnState;

    // Baca Nilai Analog Joystick
    int xVal = analogRead(JOY_X);
    int yVal = analogRead(JOY_Y);

    int centerX = 2048;
    int centerY = 2048;
    int deadzone = 800;

    // ==========================================
    // 1. MODE KURSOR (MOUSE)
    // ==========================================
    if (isMouseMode) {
      int moveX = 0;
      int moveY = 0;

      // Gerakan Kursor Halus
      if (abs(xVal - centerX) > deadzone) {
        moveX = map(xVal, 0, 4095, -8, 8);
      }
      if (abs(yVal - centerY) > deadzone) {
        moveY = map(yVal, 0, 4095, -8, 8);
      }

      if (moveX != 0 || moveY != 0) {
        Mouse.move(moveX, moveY);
      }

      // Tombol Joystick berfungsi sebagai Klik Kiri
      bool joyBtnState = digitalRead(JOY_SW);
      if (lastJoyBtn == HIGH && joyBtnState == LOW) {
        Mouse.click(MOUSE_LEFT);
        delay(100);
      }
      lastJoyBtn = joyBtnState;
    } 

    // ==========================================
    // 2. MODE NORMAL (WASD)
    // ==========================================
    else {
      bool wantW = (yVal < centerY - deadzone);
      bool wantS = (yVal > centerY + deadzone);
      bool wantA = (xVal < centerX - deadzone);
      bool wantD = (xVal > centerX + deadzone);

      if (wantW != isW) { if (wantW) Keyboard.press('w'); else Keyboard.release('w'); isW = wantW; }
      if (wantS != isS) { if (wantS) Keyboard.press('s'); else Keyboard.release('s'); isS = wantS; }
      if (wantA != isA) { if (wantA) Keyboard.press('a'); else Keyboard.release('a'); isA = wantA; }
      if (wantD != isD) { if (wantD) Keyboard.press('d'); else Keyboard.release('d'); isD = wantD; }

      // Tombol Joystick berfungsi sebagai Lompat (Spasi)
      bool joyBtnState = digitalRead(JOY_SW);
      if (lastJoyBtn == HIGH && joyBtnState == LOW) {
        Keyboard.press(' ');
        delay(50);
        Keyboard.release(' ');
      }
      lastJoyBtn = joyBtnState;
    }

    delay(15);
  } else {
    delay(1000);
  }
}
