#include <BleCombo.h>

// ==========================================
// PIN JOYSTICK KIRI (Jalan WASD & Lompat)
// ==========================================
#define JOY_L_X  32
#define JOY_L_Y  33
#define JOY_L_SW 26

// ==========================================
// PIN JOYSTICK KANAN (Kamera Roblox & Klik)
// ==========================================
#define JOY_R_X  34
#define JOY_R_Y  35
#define JOY_R_SW 25

// Variable status tombol (mencegah spam sinyal BLE)
bool isW = false, isS = false, isA = false, isD = false;
bool lastLeftBtn  = HIGH;
bool lastRightBtn = HIGH;
bool isRightClickHolding = false; // Status tahan klik kanan kamera

void setup() {
  Serial.begin(115200);

  pinMode(JOY_L_SW, INPUT_PULLUP);
  pinMode(JOY_R_SW, INPUT_PULLUP);

  Keyboard.begin();
  Mouse.begin();
}

void loop() {
  if (Keyboard.isConnected()) {

    int centerVal = 2048;
    int deadzone  = 800;

    // ==========================================
    // 1. JOYSTICK KIRI -> GERAK JALAN (WASD)
    // ==========================================
    int xLeft = analogRead(JOY_L_X);
    int yLeft = analogRead(JOY_L_Y);

    bool wantW = (yLeft < centerVal - deadzone);
    bool wantS = (yLeft > centerVal + deadzone);
    bool wantA = (xLeft < centerVal - deadzone);
    bool wantD = (xLeft > centerVal + deadzone);

    if (wantW != isW) { if (wantW) Keyboard.press('w'); else Keyboard.release('w'); isW = wantW; }
    if (wantS != isS) { if (wantS) Keyboard.press('s'); else Keyboard.release('s'); isS = wantS; }
    if (wantA != isA) { if (wantA) Keyboard.press('a'); else Keyboard.release('a'); isA = wantA; }
    if (wantD != isD) { if (wantD) Keyboard.press('d'); else Keyboard.release('d'); isD = wantD; }

    // Tombol Joystick Kiri -> Lompat (Spasi)
    bool leftBtnState = digitalRead(JOY_L_SW);
    if (lastLeftBtn == HIGH && leftBtnState == LOW) {
      Keyboard.press(' ');
      delay(50);
      Keyboard.release(' ');
    }
    lastLeftBtn = leftBtnState;


    // ==========================================
    // 2. JOYSTICK KANAN -> ROTASI LAYAR ROBLOX (TAHAN KLIK KANAN + GESER)
    // ==========================================
    int xRight = analogRead(JOY_R_X);
    int yRight = analogRead(JOY_R_Y);

    int moveX = 0;
    int moveY = 0;

    if (abs(xRight - centerVal) > deadzone) {
      moveX = map(xRight, 0, 4095, -15, 15); // Sensitivitas geser X
    }
    if (abs(yRight - centerVal) > deadzone) {
      moveY = map(yRight, 0, 4095, -15, 15); // Sensitivitas geser Y
    }

    // Jika joystick kanan digerakkan dari titik tengah
    if (moveX != 0 || moveY != 0) {
      if (!isRightClickHolding) {
        Mouse.press(MOUSE_RIGHT); // TAHAN KLIK KANAN
        isRightClickHolding = true;
      }
      Mouse.move(moveX, moveY); // GESER MOUSE
    } else {
      // Jika joystick dilepas balik ke tengah, lepas klik kanan
      if (isRightClickHolding) {
        Mouse.release(MOUSE_RIGHT); // LEPAS KLIK KANAN
        isRightClickHolding = false;
      }
    }

    // ==========================================
    // 3. TOMBOL JOYSTICK KANAN (PIN 25) -> KLIK KIRI MOUSE
    // ==========================================
    bool rightBtnState = digitalRead(JOY_R_SW);
    if (lastRightBtn == HIGH && rightBtnState == LOW) {
      Mouse.press(MOUSE_LEFT);
      delay(50);
      Mouse.release(MOUSE_LEFT);
    }
    lastRightBtn = rightBtnState;

    delay(15);
  } else {
    delay(1000);
  }
}
